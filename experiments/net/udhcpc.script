#!/bin/sh
# udhcpc callback for L1 (busybox has no default.script on the initramfs)
case "$1" in
  deconfig) ifconfig "$interface" 0.0.0.0 ;;
  bound|renew)
    ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}"
    if [ -n "$router" ]; then
      route del default 2>/dev/null
      for r in $router; do route add default gw "$r" dev "$interface"; done
    fi
    : > /etc/resolv.conf
    for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done
    echo "udhcpc: $interface -> $ip (gw: $router dns: $dns)"
    ;;
esac
exit 0
